# ---------- NovaSupport AI configuration (copy to .env). No paid API is required. ----------
# Database / cache (docker-compose sets these for you)
DATABASE_URL=postgresql+psycopg2://novasupport:novasupport@postgres:5432/novasupport
REDIS_URL=redis://redis:6379/0
USE_FAKE_REDIS=true            # falls back to an in-process store if Redis is unreachable

# Auth (local demo only: change for anything else)
JWT_SECRET=change-me-local-demo-secret
DEMO_PASSWORD=demo1234         # password for ALL synthetic demo accounts

# LLM: demo (default, no model needed) | ollama (local) | openai_compatible (optional, external)
LLM_PROVIDER=demo
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_COST_PER_1K_TOKENS=0.0

# Embeddings: hash (default, nothing to download) | sentence-transformers (pip install sentence-transformers)
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Synthetic data (deterministic for a given seed)
SEED=42
N_CUSTOMERS=1000
N_PRODUCTS=120
N_ORDERS=2200
AS_OF_DATE=2026-09-30          # fixed "today" for the synthetic data so demo scenarios stay stable; empty = real time

# Observability (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_CONSOLE=1
